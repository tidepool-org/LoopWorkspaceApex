//
//  Mirrors Tidepool/Loop/LoopOverride.xcconfig and Tidepool/Loop/VersionOverride.xcconfig
//  from tidepool-org/LoopWorkspace (dev). Loop.xcconfig includes this file last, so the
//  values here win. Lines marked APEX deviate from upstream on purpose.
//
//  Last synced from LoopWorkspace dev @ fe19d8060ab2318bb3a263ac1b3208cf87d1cf68
//

MAIN_APP_BUNDLE_IDENTIFIER = org.tidepool

MAIN_APP_DISPLAY_NAME = Tidepool Loop

APP_STORE_URL = itms-apps://itunes.apple.com/us/app/apple-store/id1474388545

URL_SCHEME_NAME = TidepoolLoop

// Include services for now, so QA can test acceptance flow
// APEX: DEBUG_FEATURES_ENABLED and SIMULATORS_ENABLED are unconditional here; upstream uses the _CONDITIONALLY variants.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) REMOTE_COMMANDS_DISABLED CRITICAL_ALERTS_ENABLED SCENARIOS_ENABLED SIMULATED_CORE_DATA_ENABLED WALSH_INSULIN_MODEL_DISABLED APIDRA_INSULIN_MODEL_DISABLED AFREZZA_INSULIN_MODEL_DISABLED OBSERVE_HEALTH_KIT_SAMPLES_FROM_OTHER_APPS_DISABLED MOCK_THERAPY_SETTINGS_ENABLED ENTRY_DELETION_DISABLED PREDICTED_GLUCOSE_CHART_CLAMP_ENABLED CGM_MANAGER_CATEGORIZE_GLUCOSE_RANGE_ENABLED MANUAL_DOSE_ENTRY_DISABLED INSULIN_DELIVERY_RESERVOIR_VIEW_DISABLED SIRI_DISABLED FORCE_ENGLISH SIMPLE_BOLUS_CALCULATOR_ENABLED DISABLE_POSITIVE_MOMENTUM_AND_RC_FOR_MANUAL_BOLUSES DEBUG_FEATURES_ENABLED EXPERIMENTAL_FEATURES_ENABLED_CONDITIONALLY SIMULATORS_ENABLED MISSED_MEAL_NOTIFICATIONS_DISABLED SHOW_EVENTUAL_BLOOD_GLUCOSE_ON_WATCH_DISABLED PROFILE_EXPIRATION_SETTINGS_VIEW_DISABLED DOSING_STRATEGY_SELECTION_DISABLED

LOOP_LOCAL_CACHE_DURATION_DAYS = 90

LOOP_ENTITLEMENTS = ../Tidepool/Loop/Loop/Loop.entitlements

LOOP_DEVELOPMENT_TEAM = 75U4X84TEG

// Min iOS Version
IPHONEOS_DEPLOYMENT_TARGET = 18.6

// Points WORKSPACE_ROOT to the LoopWorkspace (parent directory)
WORKSPACE_ROOT = ..

// Version (upstream keeps this in Tidepool/Loop/VersionOverride.xcconfig)
LOOP_MARKETING_VERSION = 2.0.0
